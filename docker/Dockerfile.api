FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --no-deps xgboost==3.4.1

RUN pip install --no-cache-dir \
    scikit-learn==1.9.1 \
    pandas==2.3.3 \
    numpy==2.5.4 \
    joblib==1.6.0 \
    fastapi \
    requests \
    uvicorn

RUN pip install --no-cache-dir pyarrow==25.0.1

COPY src/api.py src/model_features.py ./src/
COPY models/xgb_model.joblib ./models/xgb_model.joblib

EXPOSE 8000

CMD ["uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "8000"]
